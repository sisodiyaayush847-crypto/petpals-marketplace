# ============================================================
# Supabase — get these from your Supabase project dashboard
# Project Settings -> API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
# Service role key — SERVER ONLY, never expose to the browser.
# Used by admin actions and webhooks. Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ============================================================
# Razorpay — https://dashboard.razorpay.com (use Test Mode keys first)
# Settings -> API Keys
# ============================================================
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# Webhook secret — Settings -> Webhooks (set after deploy)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ============================================================
# Anthropic (Claude) — https://console.anthropic.com
# Optional. If missing, the chatbot falls back to rule-based replies.
# ============================================================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# App URL (used for redirects / Razorpay callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
